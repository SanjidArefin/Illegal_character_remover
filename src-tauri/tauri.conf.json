{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "illegal-character-remover",
  "version": "0.1.1",
  "identifier": "com.sanjid.illegal-character-remover",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Illegal Character Remover",
        "width": 980,
        "height": 760,
        "minWidth": 680,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/illegal-char-remover"]
  }
}
